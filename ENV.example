DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-en-produccion"
MP_ACCESS_TOKEN="tu-mercadopago-access-token"

# WhatsApp (para coordinar envío post-compra)
# Formato recomendado: solo dígitos con código de país (ej: 5493515900630)
# NEXT_PUBLIC_COMPANY_WHATSAPP="5493515900630"

# SMTP (emails)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASSWORD="tu-app-password"
# SMTP_FROM="COP <tu-email@gmail.com>"
# CONTACT_TO_EMAIL="franciscogodoy_@hotmail.com"
# ORDER_BCC_EMAIL="pedidos@tudominio.com"

# Webhook signature (recomendado en producción)
# MP_WEBHOOK_SECRET="tu-secret-signature"
# MP_WEBHOOK_TOLERANCE_SECONDS="300"

# Admin (emails con acceso al panel admin, separados por coma)
# ADMIN_EMAILS="pedidoscoprecubrimientos@gmail.com,otroadmin@gmail.com"

# Opcional: forzar auto-return (solo recomendado con URL https pública)
# MP_FORCE_AUTO_RETURN="true"

