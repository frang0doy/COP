## Plantilla para variables de entorno (LOCAL)
## Copiá este archivo como `.env.local` en la raíz del proyecto y completá los valores.
## (El archivo `.env.local` normalmente no se sube al repo.)

# Base de datos (PostgreSQL - Neon/Supabase/etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# NextAuth (local)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REEMPLAZAR_POR_UNA_STRING_LARGA"

# Mercado Pago (backend)
# Este proyecto crea la preferencia desde el servidor y redirige con init_point,
# por eso necesita el Access Token (secreto).
MP_ACCESS_TOKEN="REEMPLAZAR_POR_TU_MP_ACCESS_TOKEN"

# SMTP (para emails de confirmación y contacto)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASSWORD="tu-app-password"
# SMTP_FROM="COP <tu-email@gmail.com>"
#
# (Opcional) BCC para recibir copia de confirmaciones de compra
# ORDER_BCC_EMAIL="pedidos@tudominio.com"

# Webhook signature (Mercado Pago) - recomendado en producción
# Se genera en Mercado Pago Developers → Your integrations → Webhooks → Secret signature
# MP_WEBHOOK_SECRET="TU_SECRET_SIGNATURE"
# (Opcional) tolerancia de tiempo para firma (segundos). Default: 300
# MP_WEBHOOK_TOLERANCE_SECONDS="300"

# Admin (solo 2 emails: vos y el cliente). Al loguear, se promueven a ADMIN.
# ADMIN_EMAILS="tuemail@dominio.com,emailcliente@dominio.com"

# Si estás probando con un túnel https (ngrok, cloudflared, etc.) y querés que MP
# redirija automáticamente al aprobar el pago, podés forzarlo:
# MP_FORCE_AUTO_RETURN="true"

# (Opcional) URL pública/https para webhooks (si no se infiere desde NEXTAUTH_URL)
# MP_NOTIFICATION_URL="https://tu-dominio.com/api/mercadopago/webhook"

# (Opcional / no usado actualmente por el código)
# MP_PUBLIC_KEY="REEMPLAZAR_POR_TU_PUBLIC_KEY"
# MP_CLIENT_ID="REEMPLAZAR_POR_TU_CLIENT_ID"
# MP_CLIENT_SECRET="REEMPLAZAR_POR_TU_CLIENT_SECRET"

